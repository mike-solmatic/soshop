<% content_for :title, "Dashboard — #{current_seller.store_name}" %>

<div class="page-head">
  <div>
    <h1>Dashboard</h1>
    <div class="sub">What's happening at <%= current_seller.store_name %></div>
  </div>
  <%= link_to "View storefront →", storefront_path(current_seller.slug), class: "btn btn-outline" %>
</div>

<div class="stat-grid">
  <div class="stat-card accent">
    <div class="label">New orders</div>
    <div class="value"><%= @new_orders_count %></div>
    <div class="hint">last 7 days</div>
  </div>
  <div class="stat-card accent">
    <div class="label">New customers</div>
    <div class="value"><%= @new_customers_count %></div>
    <div class="hint">last 7 days</div>
  </div>
  <div class="stat-card accent">
    <div class="label">Revenue</div>
    <div class="value"><%= money(@revenue_cents_30d) %></div>
    <div class="hint">succeeded payments, 30 days</div>
  </div>
  <div class="stat-card accent">
    <div class="label">Awaiting action</div>
    <div class="value"><%= @pending_orders %></div>
    <div class="hint">pending orders</div>
  </div>
</div>

<div class="card">
  <div class="card-head"><h3>Revenue — last 14 days</h3></div>
  <div class="card-body">
    <%= react_component "RevenueChart", { data: @chart_data } %>
  </div>
</div>

<div class="two-col" style="margin-top: 1.25rem">
  <div class="card mt-0">
    <div class="card-head">
      <h3>Recent orders</h3>
      <%= link_to "View all", sellers_orders_path, class: "text-sm" %>
    </div>
    <div class="card-body flush table-wrap">
      <table class="nice">
        <thead>
          <tr><th>Order</th><th>Customer</th><th>Status</th><th class="num">Total</th></tr>
        </thead>
        <tbody>
          <% @recent_orders.each do |order| %>
            <tr class="linky" data-controller="row-link" data-row-link-url-value="<%= sellers_order_path(order) %>" data-action="click->row-link#visit">
              <td><%= link_to order.number, sellers_order_path(order) %></td>
              <td><%= order.customer.name %></td>
              <td><%= order_status_badge(order) %></td>
              <td class="num"><%= money(order.total_cents) %></td>
            </tr>
          <% end %>
          <% if @recent_orders.empty? %>
            <tr><td colspan="4" class="dt-empty">No orders yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card mt-0">
    <div class="card-head">
      <h3>New customers</h3>
      <%= link_to "View all", sellers_customers_path, class: "text-sm" %>
    </div>
    <div class="card-body flush table-wrap">
      <table class="nice">
        <tbody>
          <% @recent_customers.each do |customer| %>
            <tr class="linky" data-controller="row-link" data-row-link-url-value="<%= sellers_customer_path(customer) %>" data-action="click->row-link#visit">
              <td style="width: 42px"><%= avatar_tag(customer.name, customer.avatar_url) %></td>
              <td>
                <strong><%= customer.name %></strong><br>
                <span class="text-muted text-sm">joined <%= time_ago_in_words(customer.created_at) %> ago</span>
              </td>
            </tr>
          <% end %>
          <% if @recent_customers.empty? %>
            <tr><td colspan="2" class="dt-empty">No customers yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
