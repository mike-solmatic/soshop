<% content_for :title, "Account settings — SoShop" %>

<div class="auth-wrap">
  <div class="auth-card">
    <h1>Account settings</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <% if resource_name == :seller %>
        <div class="field">
          <%= f.label :name, "Your name" %>
          <%= f.text_field :name %>
        </div>
        <div class="field">
          <%= f.label :store_name %>
          <%= f.text_field :store_name %>
        </div>
      <% end %>

      <div class="field">
        <%= f.label :email %>
        <%= f.email_field :email, autocomplete: "email" %>
      </div>

      <div class="field">
        <%= f.label :password, "New password" %>
        <%= f.password_field :password, autocomplete: "new-password" %>
        <div class="hint">Leave blank to keep your current password</div>
      </div>

      <div class="field">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
      </div>

      <div class="field">
        <%= f.label :current_password %>
        <%= f.password_field :current_password, autocomplete: "current-password" %>
        <div class="hint">We need your current password to confirm changes</div>
      </div>

      <%= f.submit "Update", class: "btn btn-primary", data: { turbo: false } %>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
