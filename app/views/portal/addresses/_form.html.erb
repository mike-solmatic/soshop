<%= form_with model: [ :portal, address ] do |f| %>
  <% if address.errors.any? %>
    <div class="error-box">
      <strong>Please fix the following:</strong>
      <ul>
        <% address.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-grid">
    <div class="field">
      <%= f.label :label, "Label" %>
      <%= f.text_field :label, placeholder: "Home, Office…" %>
    </div>
    <div class="field">
      <%= f.label :recipient %>
      <%= f.text_field :recipient %>
    </div>
    <div class="field full">
      <%= f.label :line1, "Address line 1" %>
      <%= f.text_field :line1 %>
    </div>
    <div class="field full">
      <%= f.label :line2, "Address line 2 (optional)" %>
      <%= f.text_field :line2 %>
    </div>
    <div class="field">
      <%= f.label :city %>
      <%= f.text_field :city %>
    </div>
    <div class="field">
      <%= f.label :state, "State / Region" %>
      <%= f.text_field :state %>
    </div>
    <div class="field">
      <%= f.label :postal_code %>
      <%= f.text_field :postal_code %>
    </div>
    <div class="field">
      <%= f.label :country %>
      <%= f.text_field :country %>
    </div>
    <div class="field full">
      <%= f.label :phone, "Phone (optional)" %>
      <%= f.telephone_field :phone %>
    </div>
  </div>

  <%= f.submit address.persisted? ? "Save changes" : "Add address", class: "btn btn-primary" %>
  <%= link_to "Cancel", portal_addresses_path, class: "btn btn-outline" %>
<% end %>
